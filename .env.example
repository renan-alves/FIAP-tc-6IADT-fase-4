# Configurações Gerais
DEBUG=False
LOG_LEVEL=INFO

# Caminhos
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=data/reports
VIDEO_INPUT_DIR=data/videos
TEMP_DIR=.temp

# YOLOv8
YOLO_MODEL_PATH=models/yolo_instruments/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
DEVICE=cuda  # ou 'cpu'

# Processamento de Vídeo
VIDEO_FRAME_RATE=30
VIDEO_RESIZE_WIDTH=640
VIDEO_RESIZE_HEIGHT=480
VIDEO_SKIP_FRAMES=1

# Relatórios
REPORT_FORMAT=pdf  # pdf ou docx
REPORT_LANGUAGE=pt-BR

# API (para uso futuro)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_FILE=logs/assistente.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Audio Processing (Fase 2)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Text Processing (Fase 3)
OCR_LANGUAGE=pt

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
